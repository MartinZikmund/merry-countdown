<Page
    x:Class="MerryCountdown.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:toolkit="using:Uno.UI.Behaviors"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="not_win">

    <Grid toolkit:VisibleBoundsPadding.PaddingMask="All">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  WinUI title bar (Windows head only; stripped on Uno heads, collapsing this row).  -->
        <win:TitleBar
            x:Name="AppTitleBar"
            Title="{markup:Localize Key=ApplicationName}"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="False">
            <win:TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Icons/icon_foreground.png" />
            </win:TitleBar.IconSource>
            <!--
                RightHeader sits before the system caption buttons and the min drag region, so the
                badge can never overlap the close button the way a corner overlay does.
            -->
            <win:TitleBar.RightHeader>
                <controls:DevChannelBadge Margin="0,0,8,0" VerticalAlignment="Center" />
            </win:TitleBar.RightHeader>
        </win:TitleBar>

        <Grid
            x:Name="AppContent"
            Grid.Row="1"
            Loaded="AppContent_Loaded"
            SizeChanged="AppContent_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Padding="8,4"
                Background="{ThemeResource AppBarBackgroundBrush}"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Windows goes back from its title bar instead.  -->
                <not_win:Button
                    Width="44"
                    Height="44"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="NavBack"
                    AutomationProperties.Name="{markup:Localize Key=NavBack}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Back_Click"
                    CornerRadius="22"
                    Foreground="{ThemeResource PageTextBrush}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}">
                    <FontIcon FontSize="20" Glyph="&#xE72B;" />
                </not_win:Button>

                <StackPanel
                    x:Name="TabPanel"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <RadioButton
                        x:Name="CountdownTab"
                        AutomationProperties.AutomationId="NavCountdown"
                        AutomationProperties.Name="{markup:Localize Key=NavCountdown}"
                        Checked="Tab_Checked"
                        GroupName="AppSections"
                        Style="{StaticResource AppBarTabStyle}"
                        Tag="Countdown">
                        <StackPanel x:Name="CountdownTabContent" Style="{StaticResource AppBarTabContentStyle}">
                            <Image
                                Width="28"
                                Height="28"
                                Source="ms-appx:///Assets/Stickers/tree.png" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{markup:Localize Key=NavCountdown}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="CalendarTab"
                        AutomationProperties.AutomationId="NavCalendar"
                        AutomationProperties.Name="{x:Bind ViewModel.DoorsTabName, Mode=OneWay}"
                        Checked="Tab_Checked"
                        GroupName="AppSections"
                        Style="{StaticResource AppBarTabStyle}"
                        Tag="Calendar">
                        <StackPanel x:Name="CalendarTabContent" Style="{StaticResource AppBarTabContentStyle}">
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="28"
                                    Height="28"
                                    Source="ms-appx:///Assets/Stickers/door.png" />
                                <!--  Says there's a new door to open, from every page, without standing in the way.  -->
                                <Border
                                    Grid.Column="1"
                                    Height="18"
                                    MinWidth="18"
                                    Margin="-6,0,0,0"
                                    Padding="4,0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="WaitingDoorBadge"
                                    Background="{StaticResource DoorBadgeBrush}"
                                    CornerRadius="9"
                                    Visibility="{x:Bind ViewModel.HasWaitingDoor, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource SceneTextBrush}"
                                        Text="{x:Bind ViewModel.WaitingDoorNumber, Mode=OneWay}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{markup:Localize Key=NavCalendar}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="WishesTab"
                        AutomationProperties.AutomationId="NavWishes"
                        AutomationProperties.Name="{markup:Localize Key=NavWishes}"
                        Checked="Tab_Checked"
                        GroupName="AppSections"
                        Style="{StaticResource AppBarTabStyle}"
                        Tag="Wishes">
                        <StackPanel x:Name="WishesTabContent" Style="{StaticResource AppBarTabContentStyle}">
                            <Image
                                Width="28"
                                Height="28"
                                Source="ms-appx:///Assets/Stickers/letter.png" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{markup:Localize Key=NavWishes}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!--
                    Dev-channel indicator for heads with no WinUI TitleBar (the Windows head hosts the
                    same control in TitleBar.RightHeader above). The not_win wrapper is mc:Ignorable, so
                    this whole subtree is dropped on Windows.
                -->
                <not_win:Border
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <controls:DevChannelBadge />
                </not_win:Border>

                <!--  For the grown-ups, so it stays out of the way: no sticker, no label.  -->
                <RadioButton
                    x:Name="SettingsTab"
                    Grid.Column="2"
                    MinWidth="44"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SettingsItem"
                    AutomationProperties.Name="{markup:Localize Key=NavSettings}"
                    Checked="Tab_Checked"
                    GroupName="AppSections"
                    Style="{StaticResource AppBarTabStyle}"
                    Tag="Settings"
                    ToolTipService.ToolTip="{markup:Localize Key=NavSettings}">
                    <FontIcon FontSize="20" Glyph="&#xE713;" />
                </RadioButton>
            </Grid>

            <Frame x:Name="InnerFrame" Grid.Row="1" />

        </Grid>

        <!--  The Family Display covers the whole window, title bar and navigation included.  -->
        <ContentControl
            x:Name="DisplayHost"
            Grid.RowSpan="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />

        <!--  So does the compact overlay. The title bar underneath still drags the window.  -->
        <ContentControl
            x:Name="CompactOverlayHost"
            Grid.RowSpan="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
    </Grid>
</Page>
