<Page
    x:Class="MerryCountdown.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:toolkit="using:Uno.UI.Behaviors"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="not_win">

    <Grid toolkit:VisibleBoundsPadding.PaddingMask="All">
        <Grid
            x:Name="AppContent"
            Loaded="AppContent_Loaded"
            SizeChanged="AppContent_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                On Windows this is the title bar too: the tabs share a row with the caption buttons,
                and the inset columns keep them out from under those. See docs/app-bar.md.
            -->
            <Grid
                x:Name="AppBar"
                Padding="8,4"
                Background="{ThemeResource AppBarBackgroundBrush}"
                ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!--  The only part of the bar that drags the window, so it never sits under a control.  -->
                <win:Border
                    x:Name="DragRegion"
                    Grid.Row="1"
                    Grid.Column="3"
                    Background="Transparent" />

                <!--  Too narrow to leave a handle beside the tabs: they drop under a slim title strip instead.  -->
                <win:StackPanel
                    x:Name="TitleStrip"
                    Grid.ColumnSpan="8"
                    Height="32"
                    Margin="4,-4,0,0"
                    IsHitTestVisible="False"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/Icons/icon_foreground.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource PageTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=ApplicationName}" />
                </win:StackPanel>

                <Button
                    x:Name="BackButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="NavBack"
                    AutomationProperties.Name="{markup:Localize Key=NavBack}"
                    Click="Back_Click"
                    SizeChanged="AppBarContent_SizeChanged"
                    Style="{StaticResource AppBarIconButtonStyle}"
                    ToolTipService.ToolTip="{markup:Localize Key=NavBack}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}">
                    <FontIcon FontSize="20" Glyph="&#xE72B;" />
                </Button>

                <StackPanel
                    x:Name="TabPanel"
                    Grid.Row="1"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    SizeChanged="AppBarContent_SizeChanged"
                    Spacing="4">
                    <RadioButton
                        x:Name="CountdownTab"
                        AutomationProperties.AutomationId="NavCountdown"
                        AutomationProperties.Name="{markup:Localize Key=NavCountdown}"
                        Checked="Tab_Checked"
                        GroupName="AppSections"
                        Style="{StaticResource AppBarTabStyle}"
                        Tag="Countdown">
                        <StackPanel x:Name="CountdownTabContent" Style="{StaticResource AppBarTabContentStyle}">
                            <Image
                                Width="28"
                                Height="28"
                                Source="ms-appx:///Assets/Stickers/tree.png" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{markup:Localize Key=NavCountdown}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="CalendarTab"
                        AutomationProperties.AutomationId="NavCalendar"
                        AutomationProperties.Name="{x:Bind ViewModel.DoorsTabName, Mode=OneWay}"
                        Checked="Tab_Checked"
                        GroupName="AppSections"
                        Style="{StaticResource AppBarTabStyle}"
                        Tag="Calendar">
                        <StackPanel x:Name="CalendarTabContent" Style="{StaticResource AppBarTabContentStyle}">
                            <!--  Centered, or it stretches to the label's width when stacked and the door slides left.  -->
                            <Grid Height="28" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="28"
                                    Height="28"
                                    Source="ms-appx:///Assets/Stickers/door.png" />
                                <!--  Says there's a new door to open, from every page, without standing in the way.  -->
                                <Border
                                    Grid.Column="1"
                                    Height="18"
                                    MinWidth="18"
                                    Margin="-6,0,0,0"
                                    Padding="4,0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="WaitingDoorBadge"
                                    Background="{StaticResource DoorBadgeBrush}"
                                    CornerRadius="9"
                                    Visibility="{x:Bind ViewModel.HasWaitingDoor, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource SceneTextBrush}"
                                        Text="{x:Bind ViewModel.WaitingDoorNumber, Mode=OneWay}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{markup:Localize Key=NavCalendar}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="WishesTab"
                        AutomationProperties.AutomationId="NavWishes"
                        AutomationProperties.Name="{markup:Localize Key=NavWishes}"
                        Checked="Tab_Checked"
                        GroupName="AppSections"
                        Style="{StaticResource AppBarTabStyle}"
                        Tag="Wishes">
                        <StackPanel x:Name="WishesTabContent" Style="{StaticResource AppBarTabContentStyle}">
                            <Image
                                Width="28"
                                Height="28"
                                Source="ms-appx:///Assets/Stickers/letter.png" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{markup:Localize Key=NavWishes}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <controls:DevChannelBadge
                    x:Name="ChannelBadge"
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    SizeChanged="AppBarContent_SizeChanged" />

                <!--  Home's look and its display modes: one button, in the bar, out of the scene's way.  -->
                <Button
                    x:Name="CustomizeButton"
                    Grid.Row="1"
                    Grid.Column="5"
                    AutomationProperties.AutomationId="CustomizeButton"
                    AutomationProperties.Name="{markup:Localize Key=Customize}"
                    SizeChanged="AppBarContent_SizeChanged"
                    Style="{StaticResource AppBarIconButtonStyle}"
                    ToolTipService.ToolTip="{markup:Localize Key=Customize}"
                    Visibility="Collapsed">
                    <FontIcon FontSize="20" Glyph="&#xE790;" />
                    <Button.Flyout>
                        <Flyout x:Name="CustomizeFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="800" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--  For the grown-ups, so it stays out of the way: no sticker, no label.  -->
                <RadioButton
                    x:Name="SettingsTab"
                    Grid.Row="1"
                    Grid.Column="6"
                    MinWidth="44"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SettingsItem"
                    AutomationProperties.Name="{markup:Localize Key=NavSettings}"
                    Checked="Tab_Checked"
                    GroupName="AppSections"
                    Style="{StaticResource AppBarTabStyle}"
                    Tag="Settings"
                    ToolTipService.ToolTip="{markup:Localize Key=NavSettings}">
                    <FontIcon FontSize="20" Glyph="&#xE713;" />
                </RadioButton>
            </Grid>

            <Frame x:Name="InnerFrame" Grid.Row="1" />

        </Grid>

        <!--  The Family Display covers the whole window, navigation included.  -->
        <ContentControl
            x:Name="DisplayHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />

        <!--  So does the compact overlay.  -->
        <ContentControl
            x:Name="CompactOverlayHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />

        <!--  The app bar is collapsed under the overlay, so this strip is what drags the little window.  -->
        <win:Border
            x:Name="OverlayDragRegion"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent"
            Visibility="Collapsed" />
    </Grid>
</Page>
