<Page
    x:Class="MerryCountdown.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:toolkit="using:Uno.UI.Behaviors"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="not_win">

    <Grid toolkit:VisibleBoundsPadding.PaddingMask="All">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  WinUI title bar (Windows head only; stripped on Uno heads, collapsing this row).  -->
        <win:TitleBar
            x:Name="AppTitleBar"
            Title="{markup:Localize Key=ApplicationName}"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="False">
            <win:TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Icons/icon_foreground.png" />
            </win:TitleBar.IconSource>
            <!--
                RightHeader sits before the system caption buttons and the min drag region, so the
                badge can never overlap the close button the way a corner overlay does.
            -->
            <win:TitleBar.RightHeader>
                <controls:DevChannelBadge Margin="0,0,8,0" VerticalAlignment="Center" />
            </win:TitleBar.RightHeader>
        </win:TitleBar>

        <!--  NavigationView  -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            not_win:IsBackButtonVisible="Auto"
            not_win:IsPaneToggleButtonVisible="True"
            win:IsBackButtonVisible="Collapsed"
            win:IsPaneToggleButtonVisible="False"
            BackRequested="NavView_BackRequested"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1008"
            IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsTitleBarAutoPaddingEnabled="False"
            Loaded="NavView_Loaded"
            OpenPaneLength="280"
            PaneDisplayMode="Top"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="CountdownNavItem"
                    AutomationProperties.AutomationId="NavCountdown"
                    Content="{markup:Localize Key=NavCountdown}"
                    Tag="Countdown">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CalendarNavItem"
                    AutomationProperties.AutomationId="NavCalendar"
                    Content="{markup:Localize Key=NavCalendar}"
                    Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="WishesNavItem"
                    AutomationProperties.AutomationId="NavWishes"
                    Content="{markup:Localize Key=NavWishes}"
                    Tag="Wishes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="InnerFrame" />
        </NavigationView>

        <!--
            Dev-channel indicator for heads with no WinUI TitleBar (the Windows head hosts the
            same control in TitleBar.RightHeader above). The not_win wrapper is mc:Ignorable, so
            this whole subtree is dropped on Windows.
        -->
        <not_win:Border
            Grid.RowSpan="2"
            Margin="0,56,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <controls:DevChannelBadge />
        </not_win:Border>

        <!--  The Family Display covers the whole window, title bar and navigation included.  -->
        <ContentControl
            x:Name="DisplayHost"
            Grid.RowSpan="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
    </Grid>
</Page>
