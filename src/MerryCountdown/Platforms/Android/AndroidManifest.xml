<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Needed for HttpRefit and AppUpdater. Remove for a fully offline app. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Kebechet.Maui.RevenueCat.Android pulls in play-services-ads-identifier, which declares this; the Families policy forbids it in a kids' app. -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <application android:allowBackup="true" android:supportsRtl="true"></application>
</manifest>
