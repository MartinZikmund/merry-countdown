<Application
    x:Class="MerryCountdown.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:MerryCountdown.Resources">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Load WinUI resources  -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///SettingsControls/SettingsCard/SettingsCard.xaml" />
                <ResourceDictionary Source="ms-appx:///SettingsControls/SettingsExpander/SettingsExpander.xaml" />
                <ResourceDictionary Source="/Resources/Colors.xaml" />
                <resources:Converters />
                <ResourceDictionary Source="/Resources/Styles.xaml" />
                <resources:DataTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
