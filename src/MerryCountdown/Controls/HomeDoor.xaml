<UserControl
    x:Class="MerryCountdown.Controls.HomeDoor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="DoorButton"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        Click="OnClick"
        Style="{StaticResource SubtleButtonStyle}">
        <!--  Drawn at 216 by 312 and scaled down, so the home screen can keep it small and quiet.  -->
        <Viewbox x:Name="DoorScale">
            <Grid Width="216" Height="312">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Jiggle" />
                </Grid.RenderTransform>

                <Border Background="#E8A84C" CornerRadius="108,108,6,6">
                    <Image
                        Width="104"
                        Height="104"
                        Source="ms-appx:///Assets/Stickers/gift.png" />
                </Border>

                <Grid x:Name="Leaf" RenderTransformOrigin="0,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LeafScale" />
                    </Grid.RenderTransform>
                    <Border x:Name="LeafFace" CornerRadius="108,108,6,6" />
                    <Border
                        x:Name="UpperPanel"
                        Height="56"
                        Margin="24,146,24,0"
                        VerticalAlignment="Top"
                        BorderThickness="3"
                        CornerRadius="8" />
                    <Border
                        x:Name="LowerPanel"
                        Height="76"
                        Margin="24,214,24,0"
                        VerticalAlignment="Top"
                        BorderThickness="3"
                        CornerRadius="8" />
                    <Ellipse
                        x:Name="Wreath"
                        Width="92"
                        Height="92"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        StrokeThickness="16" />
                    <TextBlock
                        x:Name="NumberText"
                        Height="92"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        FontSize="40"
                        Foreground="{StaticResource GoldBrush}"
                        LineHeight="92"
                        LineStackingStrategy="BlockLineHeight" />
                    <Ellipse
                        x:Name="Knob"
                        Width="18"
                        Height="18"
                        Margin="0,176,20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Fill="{StaticResource GoldBrush}" />
                    <Image
                        x:Name="Padlock"
                        Width="40"
                        Height="40"
                        Margin="0,168,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Source="ms-appx:///Assets/Stickers/lock.png" />
                </Grid>

                <Border
                    BorderBrush="#CDBF9F"
                    BorderThickness="8"
                    CornerRadius="108,108,6,6"
                    IsHitTestVisible="False" />
            </Grid>
        </Viewbox>
    </Button>
</UserControl>
