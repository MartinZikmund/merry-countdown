<UserControl
    x:Class="MerryCountdown.Controls.DoorArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Drawn at 216 by 312 and scaled to whatever size the door is given.  -->
    <Viewbox>
        <Grid Width="216" Height="312">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Jiggle" />
            </Grid.RenderTransform>

            <Border x:Name="Inside" CornerRadius="108,108,6,6">
                <!--  Centred on what's visible: the open door covers the left, and the arch narrows the top.  -->
                <Image
                    x:Name="Sticker"
                    Width="104"
                    Height="104"
                    Margin="27,20,0,0" />
            </Border>

            <!--  The doorway is darker towards the hinge, where the open door shades it.  -->
            <Border CornerRadius="108,108,6,6" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#66000000" />
                        <GradientStop Offset="0.55" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border
                x:Name="Frame"
                BorderThickness="8"
                CornerRadius="108,108,6,6"
                IsHitTestVisible="False" />

            <!--  In front of the frame, so it swings out of the doorway towards the viewer.  -->
            <Grid x:Name="Leaf" Margin="8">
                <Border x:Name="LeafFace" CornerRadius="100,100,2,2" />
                <Border
                    x:Name="UpperPanel"
                    Height="56"
                    Margin="16,138,16,0"
                    VerticalAlignment="Top"
                    BorderThickness="3"
                    CornerRadius="8" />
                <Border
                    x:Name="LowerPanel"
                    Height="76"
                    Margin="16,206,16,0"
                    VerticalAlignment="Top"
                    BorderThickness="3"
                    CornerRadius="8" />
                <Ellipse
                    x:Name="Wreath"
                    Width="92"
                    Height="92"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    StrokeThickness="16" />
                <TextBlock
                    x:Name="NumberText"
                    Height="92"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="40"
                    LineHeight="92"
                    LineStackingStrategy="BlockLineHeight" />
                <Ellipse
                    x:Name="Knob"
                    Width="18"
                    Height="18"
                    Margin="0,168,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Fill="{StaticResource GoldBrush}" />
                <Image
                    x:Name="Padlock"
                    Width="40"
                    Height="40"
                    Margin="0,160,2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Source="ms-appx:///Assets/Stickers/lock.png" />

                <!--  Falls out of the light as it turns away.  -->
                <Border
                    x:Name="LeafShade"
                    Background="#000000"
                    CornerRadius="100,100,2,2"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
