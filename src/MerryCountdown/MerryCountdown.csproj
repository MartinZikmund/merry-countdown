<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>
            net10.0-android;
            net10.0-ios;
            net10.0-windows10.0.26100;
            net10.0-desktop;
            net10.0-browserwasm;
        </TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Application metadata -->
        <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
        <Description>A joyful Christmas countdown, advent calendar and wish list for kids and families.</Description>
        <UnoFeatures>$(UnoFeatures);SkiaRenderer;MediaPlayerElement</UnoFeatures>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Channel-specific identity. See docs/versioning.md. -->
    <PropertyGroup Condition="'$(AppChannel)' == 'Prod'">
        <ApplicationTitle>Merry Countdown</ApplicationTitle>
        <ApplicationId>dev.mzikmund.merrycountdown</ApplicationId>
    </PropertyGroup>

    <!-- Microsoft Store identity, from Partner Center's Product identity page. -->
    <PropertyGroup Condition="'$(AppChannel)' == 'Prod' and '$(IsWinAppSdk)' == 'true'">
        <ApplicationId>5143MartinZikmund.MerryCountdown</ApplicationId>
        <StorePackagePublisher>CN=5EDFBB6C-AD5D-4B76-B479-1C5F44017714</StorePackagePublisher>
    </PropertyGroup>

    <PropertyGroup Condition="'$(AppChannel)' == 'Dev'">
        <ApplicationTitle>Merry Countdown Dev</ApplicationTitle>
        <ApplicationId>dev.mzikmund.merrycountdown.dev</ApplicationId>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Application icon & splash screen adjustments-->
        <!-- Background is shared across channels. The app-icon resource name is derived
             from the background file (Uno maps UnoIcon.Include = UnoIconBackgroundFile),
             so the background must stay constant or Android's @mipmap/icon breaks. -->
        <UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
        <UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

        <!-- Dev channel: override only the foreground (the logo). This keeps the
             generated icon resource name stable while giving Dev a distinct look. -->
        <UnoIconForegroundFile Condition="'$(AppChannel)' == 'Dev'">Assets/Icons/icon_foreground_dev.svg</UnoIconForegroundFile>

        <UnoIconForegroundScale>1</UnoIconForegroundScale>
        <UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.6</UnoIconForegroundScale>
        <UnoSplashScreenScale>0.85</UnoSplashScreenScale>
        <UnoSplashScreenBackgroundColor>#101A3E</UnoSplashScreenBackgroundColor>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsAndroid)' == 'true' or '$(IsIOS)' == 'true'">
        <PackageReference Include="MZikmund.Uno.RevenueCat" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsAndroid)' == 'true'">
        <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MerryCountdown.Scenes\MerryCountdown.Scenes.csproj" />
        <ProjectReference Include="..\MerryCountdown.Core\MerryCountdown.Core.csproj" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <DefineConstants>$(DefineConstants);WINAPPSDK</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Resources\DataTemplates.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
    </ItemGroup>
</Project>
