<UserControl
    x:Class="MerryCountdown.Views.CompactOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:markup="using:MerryCountdown.Markup"
    IsTabStop="True"
    KeyDown="OnKeyDown">

    <Grid x:Name="Root" Background="{StaticResource SceneGlassStrongBrush}">
        <!--  The sign gets the top of the window and no more, so there is always scene left to see.  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="11*" />
        </Grid.RowDefinitions>

        <!--  Always calm: it floats over someone's work, so it shouldn't fidget or spend their battery.  -->
        <controls:SceneCanvas
            x:Name="Scene"
            Grid.RowSpan="2"
            AutomationProperties.AutomationId="CompactOverlayScene"
            AutomationProperties.Name="{markup:Localize Key=SceneAccessibleName}"
            CalmMotion="True"
            Photo="{x:Bind ViewModel.Backdrop.Photo, Mode=OneWay}"
            SceneId="{x:Bind ViewModel.SceneId}"
            Shake="{x:Bind ViewModel.Shake, Mode=OneWay}"
            ShowForeground="{x:Bind ViewModel.Backdrop.ShowForeground, Mode=OneWay}"
            Snow="{x:Bind ViewModel.Snow}"
            Tapped="Scene_Tapped" />

        <!--  Scaled to the window, with side margins that keep it out from under the close button.  -->
        <Viewbox
            x:Name="SignBox"
            Margin="48,0,48,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Stretch="Uniform">
            <controls:CountdownSign CalmMotion="{x:Bind ViewModel.CalmMotion}" Sign="{x:Bind ViewModel.Sign}" />
        </Viewbox>

        <Button
            Grid.Row="1"
            Width="40"
            Height="40"
            Margin="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="ExitCompactOverlayButton"
            AutomationProperties.Name="{markup:Localize Key=CompactOverlayExit}"
            Command="{x:Bind ViewModel.ExitCommand}"
            CornerRadius="20"
            Style="{StaticResource SceneRoundButtonStyle}"
            ToolTipService.ToolTip="{markup:Localize Key=CompactOverlayExit}">
            <FontIcon FontSize="16" Glyph="&#xE740;" />
        </Button>
    </Grid>
</UserControl>
