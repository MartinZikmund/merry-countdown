<local:CountdownViewBase
    x:Class="MerryCountdown.Views.CountdownView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:local="using:MerryCountdown.Views"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:vm="using:MerryCountdown.Core.ViewModels"
    Background="{ThemeResource PageBackdropBrush}">

    <Grid>
        <controls:SceneCanvas
            AutomationProperties.AutomationId="CountdownScene"
            AutomationProperties.Name="{markup:Localize Key=SceneAccessibleName}"
            CalmMotion="{x:Bind ViewModel.CalmMotion, Mode=OneWay}"
            Photo="{x:Bind ViewModel.Backdrop.Photo, Mode=OneWay}"
            SceneId="{x:Bind ViewModel.SceneId, Mode=OneWay}"
            ShowForeground="{x:Bind ViewModel.Backdrop.ShowForeground, Mode=OneWay}"
            Snow="{x:Bind ViewModel.Snow, Mode=OneWay}"
            Tapped="Scene_Tapped" />

        <controls:Garland VerticalAlignment="Top" Visibility="{x:Bind controls:Stickers.WhenBaubles(ViewModel.Sign.Design), Mode=OneWay}" />

        <!--  Clicks pass through to the scene everywhere except on the actual controls.  -->
        <Grid x:Name="Overlay">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <controls:CountdownSign
                    x:Name="SignControl"
                    CalmMotion="{x:Bind ViewModel.CalmMotion, Mode=OneWay}"
                    Sign="{x:Bind ViewModel.Sign}" />

                <!--  Birthdays and other family countdowns (full version)  -->
                <ItemsRepeater
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Events}"
                    Visibility="{x:Bind ViewModel.HasEvents, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpcomingEventViewModel">
                            <Border Padding="12,4" Style="{StaticResource ClockCardStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image
                                        Width="24"
                                        Height="24"
                                        Source="{x:Bind controls:Stickers.Image(Sticker)}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource SceneTextBrush}"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource GoldBrush}"
                                        Text="{x:Bind When}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!--  Today's door, small and quiet on the ground. Before December the wish letter is the thing to do.  -->
            <StackPanel
                x:Name="DoorSpot"
                VerticalAlignment="Bottom"
                Spacing="8">
                <controls:HomeDoor
                    x:Name="Door"
                    HorizontalAlignment="Center"
                    Caption="{x:Bind ViewModel.DoorCaption, Mode=OneWay}"
                    Command="{x:Bind ViewModel.OpenTodaysDoorCommand}"
                    DoorWidth="104"
                    LockedTapped="Door_LockedTapped"
                    Number="{x:Bind ViewModel.DoorNumber, Mode=OneWay}"
                    Stage="{x:Bind ViewModel.DoorStage, Mode=OneWay}"
                    Swinging="Door_Swinging" />
                <Border
                    Padding="12,2"
                    HorizontalAlignment="Center"
                    Background="{StaticResource SceneGlassStrongBrush}"
                    CornerRadius="14"
                    Visibility="{x:Bind ViewModel.HasDoorCaption, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="DoorCaption"
                        FontSize="16"
                        Foreground="{StaticResource SceneTextBrush}"
                        Style="{StaticResource SceneCaptionTextStyle}"
                        Text="{x:Bind ViewModel.DoorCaption, Mode=OneWay}" />
                </Border>
                <Button
                    AutomationProperties.AutomationId="WriteWishLetterButton"
                    Background="{StaticResource GoldBrush}"
                    Command="{x:Bind ViewModel.WriteWishLetterCommand}"
                    Foreground="{StaticResource GoldTextBrush}"
                    Style="{StaticResource BigActionButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanWriteWishLetter, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image
                            Width="32"
                            Height="32"
                            Source="ms-appx:///Assets/Stickers/letter.png" />
                        <TextBlock VerticalAlignment="Center" Text="{markup:Localize Key=WriteWishLetter}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Scene controls  -->
            <StackPanel
                Margin="16,16,16,24"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.AutomationId="ChooseSceneButton"
                    AutomationProperties.Name="{markup:Localize Key=ChooseScene}"
                    Style="{StaticResource SceneRoundButtonStyle}"
                    ToolTipService.ToolTip="{markup:Localize Key=ChooseScene}">
                    <FontIcon FontSize="24" Glyph="&#xE790;" />
                    <Button.Flyout>
                        <Flyout x:Name="SceneFlyout" Placement="TopEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="800" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel
                                x:Name="LookBody"
                                Orientation="Horizontal"
                                Spacing="24">
                                <StackPanel x:Name="LookOptions" Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ChooseStyleHeader}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.StyleOptions}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MaximumRowsOrColumns="3"
                                                MinColumnSpacing="8"
                                                MinItemHeight="112"
                                                MinItemWidth="148"
                                                MinRowSpacing="8"
                                                Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StyleOptionViewModel">
                                                <Button
                                                    Width="148"
                                                    Height="112"
                                                    Padding="4"
                                                    AutomationProperties.AutomationId="{x:Bind Style}"
                                                    AutomationProperties.Name="{x:Bind Name}"
                                                    BorderBrush="{x:Bind controls:Stickers.SelectionBrush(IsSelected), Mode=OneWay}"
                                                    BorderThickness="2"
                                                    Click="StyleOption_Click"
                                                    Tag="{x:Bind}">
                                                    <StackPanel Spacing="4">
                                                        <Viewbox Width="128" Height="56">
                                                            <controls:CountdownSign IsPreview="True" Sign="{x:Bind Preview}" />
                                                        </Viewbox>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Name}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{markup:Localize Key=ChooseSignHeader}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SignOptions}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MaximumRowsOrColumns="3"
                                                MinColumnSpacing="8"
                                                MinItemHeight="104"
                                                MinItemWidth="148"
                                                MinRowSpacing="8"
                                                Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SignOptionViewModel">
                                                <Button
                                                    Width="148"
                                                    Height="104"
                                                    Padding="4"
                                                    AutomationProperties.AutomationId="{x:Bind Design}"
                                                    AutomationProperties.Name="{x:Bind Name}"
                                                    BorderBrush="{x:Bind controls:Stickers.SelectionBrush(IsSelected), Mode=OneWay}"
                                                    BorderThickness="2"
                                                    Click="SignOption_Click"
                                                    Tag="{x:Bind}">
                                                    <StackPanel Spacing="4">
                                                        <Viewbox Width="128" Height="56">
                                                            <controls:CountdownSign IsPreview="True" Sign="{x:Bind Preview}" />
                                                        </Viewbox>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Name}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ChooseSceneHeader}" />
                                    <ItemsRepeater x:Name="SceneList" ItemsSource="{x:Bind ViewModel.Scenes}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SceneOptionViewModel">
                                                <Button
                                                    MinWidth="240"
                                                    MinHeight="48"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.AutomationId="{x:Bind Id}"
                                                    BorderBrush="{x:Bind controls:Stickers.SelectionBrush(IsSelected)}"
                                                    BorderThickness="2"
                                                    Click="SceneOption_Click"
                                                    Tag="{x:Bind}">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                                        <Image
                                                            Grid.Column="1"
                                                            Width="20"
                                                            Height="20"
                                                            Source="ms-appx:///Assets/Stickers/lock.png"
                                                            Visibility="{x:Bind IsLocked}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.AutomationId="FamilyDisplayButton"
                    AutomationProperties.Name="{markup:Localize Key=FamilyDisplay}"
                    Command="{x:Bind ViewModel.EnterFamilyDisplayCommand}"
                    Style="{StaticResource SceneRoundButtonStyle}"
                    ToolTipService.ToolTip="{markup:Localize Key=FamilyDisplay}">
                    <FontIcon FontSize="24" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</local:CountdownViewBase>
