<local:CountdownViewBase
    x:Class="MerryCountdown.Views.CountdownView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:local="using:MerryCountdown.Views"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:vm="using:MerryCountdown.Core.ViewModels"
    Background="{ThemeResource PageBackdropBrush}">

    <Grid x:Name="Root">
        <controls:SceneCanvas
            x:Name="Scene"
            AutomationProperties.AutomationId="CountdownScene"
            AutomationProperties.Name="{markup:Localize Key=SceneAccessibleName}"
            CalmMotion="{x:Bind ViewModel.CalmMotion, Mode=OneWay}"
            IsPaused="{x:Bind ViewModel.IsScenePaused, Mode=OneWay}"
            Photo="{x:Bind ViewModel.Backdrop.Photo, Mode=OneWay}"
            SceneId="{x:Bind ViewModel.SceneId, Mode=OneWay}"
            Shake="{x:Bind ViewModel.Shake, Mode=OneWay}"
            ShowForeground="{x:Bind ViewModel.Backdrop.ShowForeground, Mode=OneWay}"
            Snow="{x:Bind ViewModel.Snow, Mode=OneWay}"
            Tapped="Scene_Tapped" />

        <controls:Garland VerticalAlignment="Top" Visibility="{x:Bind controls:Stickers.WhenBaubles(ViewModel.Sign.Design), Mode=OneWay}" />

        <!--  Clicks pass through to the scene everywhere except on the actual controls.  -->
        <StackPanel
            x:Name="SkyPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <!--  Shrinks rather than loses its ends on the narrowest phones.  -->
            <Viewbox
                x:Name="SignBox"
                Margin="12,0"
                StretchDirection="DownOnly">
                <controls:CountdownSign
                    x:Name="SignControl"
                    CalmMotion="{x:Bind ViewModel.CalmMotion, Mode=OneWay}"
                    Sign="{x:Bind ViewModel.Sign}" />
            </Viewbox>

            <!--  Birthdays and other family countdowns (full version)  -->
            <ItemsRepeater
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Events}"
                Visibility="{x:Bind ViewModel.HasEvents, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:UpcomingEventViewModel">
                        <Border Padding="12,4" Style="{StaticResource ClockCardStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image
                                    Width="24"
                                    Height="24"
                                    Source="{x:Bind controls:Stickers.Image(Sticker)}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SceneTextBrush}"
                                    Text="{x:Bind Name}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource GoldBrush}"
                                    Text="{x:Bind When}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </Grid>
</local:CountdownViewBase>
