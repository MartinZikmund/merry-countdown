<local:ParentZoneViewBase
    x:Class="MerryCountdown.Views.ParentZoneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:local="using:MerryCountdown.Views"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:MerryCountdown.Core.ViewModels"
    Background="{ThemeResource PageBackdropBrush}">

    <ScrollViewer>
        <StackPanel
            MaxWidth="960"
            Padding="24"
            Spacing="8">
            <TextBlock
                Margin="0,0,0,16"
                Style="{StaticResource PageTitleTextStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

            <!--  Full version  -->
            <Border
                Padding="24"
                Background="{ThemeResource FullVersionCardBrush}"
                CornerRadius="16"
                Visibility="{x:Bind ViewModel.CanPurchase, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image
                            Width="48"
                            Height="48"
                            Source="ms-appx:///Assets/Stickers/star.png" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="28"
                            Foreground="{ThemeResource FullVersionCardForegroundBrush}"
                            Text="{markup:Localize Key=FullVersionTitle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource FullVersionCardForegroundBrush}"
                        Text="{markup:Localize Key=FullVersionPitch}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="BuyFullVersionButton"
                            Command="{x:Bind ViewModel.BuyCommand}"
                            Content="{x:Bind ViewModel.BuyButtonText, Mode=OneWay}"
                            Style="{StaticResource BigActionButtonStyle}" />
                        <Button
                            MinHeight="48"
                            AutomationProperties.AutomationId="RestoreButton"
                            Command="{x:Bind ViewModel.RestoreCommand}"
                            Content="{markup:Localize Key=RestorePurchase}"
                            CornerRadius="24"
                            Foreground="{ThemeResource FullVersionCardForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Kids. Free, because every kid in a family deserves their own wish list.  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=KidsHeader}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Kids}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:KidRowViewModel">
                        <toolkit:SettingsCard>
                            <toolkit:SettingsCard.Header>
                                <TextBox
                                    MinWidth="200"
                                    AutomationProperties.Name="{markup:Localize Key=KidNamePlaceholder}"
                                    MaxLength="24"
                                    PlaceholderText="{markup:Localize Key=KidNamePlaceholder}"
                                    Text="{x:Bind Name, Mode=TwoWay}" />
                            </toolkit:SettingsCard.Header>
                            <toolkit:SettingsCard.HeaderIcon>
                                <ImageIcon Source="{x:Bind controls:Stickers.Image(Sticker)}" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="RemoveKid_Click"
                                Content="{markup:Localize Key=Remove}"
                                IsEnabled="{x:Bind CanRemove}"
                                Tag="{x:Bind}" />
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <toolkit:SettingsCard Header="{markup:Localize Key=AddKid}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FA;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        MinWidth="160"
                        AutomationProperties.AutomationId="NewKidNameBox"
                        AutomationProperties.Name="{markup:Localize Key=AddKid}"
                        MaxLength="24"
                        PlaceholderText="{markup:Localize Key=KidNamePlaceholder}"
                        Text="{x:Bind ViewModel.NewKidName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        AutomationProperties.AutomationId="AddKidButton"
                        Command="{x:Bind ViewModel.AddKidCommand}"
                        Content="{markup:Localize Key=Add}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <!--  Full version features  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=BigDaySection}" />
            <toolkit:SettingsCard Description="{markup:Localize Key=BigDayDescription}" Header="{markup:Localize Key=BigDayHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE787;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <DatePicker
                        AutomationProperties.AutomationId="CustomBigDatePicker"
                        AutomationProperties.Name="{markup:Localize Key=BigDay_Custom}"
                        Date="{x:Bind ViewModel.CustomBigDate, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsCustomBigDay, Mode=OneWay}"
                        YearVisible="False" />
                    <ComboBox
                        AutomationProperties.AutomationId="BigDayCombo"
                        AutomationProperties.Name="{markup:Localize Key=BigDayHeader}"
                        ItemsSource="{x:Bind ViewModel.BigDayOptions}"
                        SelectedIndex="{x:Bind ViewModel.BigDayIndex, Mode=TwoWay}" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="{markup:Localize Key=BringerDescription}" Header="{markup:Localize Key=BringerHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE715;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="BringerCombo"
                    AutomationProperties.Name="{markup:Localize Key=BringerHeader}"
                    ItemsSource="{x:Bind ViewModel.BringerOptions}"
                    SelectedIndex="{x:Bind ViewModel.BringerIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <InfoBar
                Title="{markup:Localize Key=FullVersionLockedTitle}"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsFree, Mode=OneWay}"
                Message="{markup:Localize Key=FullVersionLockedMessage}"
                Severity="Informational" />

            <StackPanel
                IsHitTestVisible="{x:Bind ViewModel.IsFull, Mode=OneWay}"
                Opacity="{x:Bind local:ParentZoneView.LockedOpacity(ViewModel.IsFull), Mode=OneWay}"
                Spacing="8">
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=ArrivalHeaderSection}" />
                <toolkit:SettingsCard Description="{markup:Localize Key=ArrivalDescription}" Header="{markup:Localize Key=ArrivalHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TimePicker
                        AutomationProperties.AutomationId="ArrivalPicker"
                        AutomationProperties.Name="{markup:Localize Key=ArrivalHeader}"
                        IsEnabled="{x:Bind ViewModel.IsFull, Mode=OneWay}"
                        Time="{x:Bind ViewModel.ArrivalTime, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=PhotosHeader}" />
                <toolkit:SettingsCard Description="{markup:Localize Key=PhotosDescription}" Header="{markup:Localize Key=PhotosToggle}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button
                            AutomationProperties.AutomationId="AddPhotosButton"
                            Command="{x:Bind ViewModel.AddPhotosCommand}"
                            Content="{markup:Localize Key=PhotosAdd}"
                            IsEnabled="{x:Bind ViewModel.IsFull, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <ToggleSwitch
                            AutomationProperties.AutomationId="UsePhotosToggle"
                            AutomationProperties.Name="{markup:Localize Key=PhotosToggle}"
                            IsEnabled="{x:Bind ViewModel.HasPhotos, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.UsesPhotos, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="{markup:Localize Key=PhotoIntervalHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        AutomationProperties.AutomationId="PhotoIntervalCombo"
                        AutomationProperties.Name="{markup:Localize Key=PhotoIntervalHeader}"
                        IsEnabled="{x:Bind ViewModel.IsFull, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.PhotoIntervalOptions}"
                        SelectedIndex="{x:Bind ViewModel.PhotoIntervalIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Photos}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemHeight="120"
                            MinItemWidth="160"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoRowViewModel">
                            <Grid CornerRadius="8">
                                <Image Source="{x:Bind controls:Stickers.Photo(Bytes)}" Stretch="UniformToFill" />
                                <Button
                                    Width="44"
                                    Height="44"
                                    Margin="4"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{markup:Localize Key=RemovePhotoTitle}"
                                    Background="{StaticResource SceneGlassStrongBrush}"
                                    Click="RemovePhoto_Click"
                                    CornerRadius="22"
                                    Foreground="{StaticResource SceneTextBrush}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{markup:Localize Key=RemovePhotoTitle}">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=MessagesHeader}" />
                <toolkit:SettingsCard Description="{markup:Localize Key=MessagesDescription}" Header="{markup:Localize Key=MessageChoose}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            MinWidth="120"
                            AutomationProperties.AutomationId="MessageKidCombo"
                            AutomationProperties.Name="{markup:Localize Key=MessageKid}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.Kids}"
                            PlaceholderText="{markup:Localize Key=MessageKid}"
                            SelectedItem="{x:Bind ViewModel.MessageKid, Mode=TwoWay}" />
                        <ComboBox
                            AutomationProperties.AutomationId="MessageDoorCombo"
                            AutomationProperties.Name="{markup:Localize Key=MessageDoor}"
                            ItemsSource="{x:Bind ViewModel.DoorNumbers}"
                            SelectedItem="{x:Bind local:ParentZoneView.BoxDoor(ViewModel.MessageDoor), BindBack=SetMessageDoor, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <TextBox
                    MinHeight="80"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="MessageTextBox"
                    AutomationProperties.Name="{markup:Localize Key=MessagePlaceholder}"
                    MaxLength="200"
                    PlaceholderText="{markup:Localize Key=MessagePlaceholder}"
                    Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="SaveMessageButton"
                    Command="{x:Bind ViewModel.SaveMessageCommand}"
                    Content="{markup:Localize Key=MessageSave}" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=EventsHeader}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Events}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FamilyEventRowViewModel">
                            <toolkit:SettingsCard Description="{x:Bind Date}" Header="{x:Bind Name}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="{x:Bind controls:Stickers.Image(Sticker)}" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button
                                    Click="RemoveEvent_Click"
                                    Content="{markup:Localize Key=Remove}"
                                    Tag="{x:Bind}" />
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <toolkit:SettingsCard Description="{markup:Localize Key=EventsDescription}" Header="{markup:Localize Key=AddEvent}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE710;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            MinWidth="140"
                            AutomationProperties.AutomationId="NewEventNameBox"
                            AutomationProperties.Name="{markup:Localize Key=EventName}"
                            MaxLength="30"
                            PlaceholderText="{markup:Localize Key=EventName}"
                            Text="{x:Bind ViewModel.NewEventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CalendarDatePicker
                            AutomationProperties.AutomationId="NewEventDatePicker"
                            AutomationProperties.Name="{markup:Localize Key=EventName}"
                            Date="{x:Bind ViewModel.NewEventDate, Mode=TwoWay}" />
                        <Button
                            AutomationProperties.AutomationId="AddEventButton"
                            Command="{x:Bind ViewModel.AddEventCommand}"
                            Content="{markup:Localize Key=Add}" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </StackPanel>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=GateHeader}" />
            <toolkit:SettingsCard Description="{markup:Localize Key=KeepUnlockedDescription}" Header="{markup:Localize Key=KeepUnlockedHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE785;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="KeepUnlockedToggle"
                    AutomationProperties.Name="{markup:Localize Key=KeepUnlockedHeader}"
                    IsOn="{x:Bind ViewModel.KeepUnlocked, Mode=TwoWay}" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</local:ParentZoneViewBase>
