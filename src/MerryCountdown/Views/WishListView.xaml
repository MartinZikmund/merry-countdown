<local:WishListViewBase
    x:Class="MerryCountdown.Views.WishListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:local="using:MerryCountdown.Views"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:vm="using:MerryCountdown.Core.ViewModels"
    Background="{ThemeResource PageBackdropBrush}">

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ToolsColumn" Width="384" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Only the letter scrolls, so the way to add a wish stays in reach.  -->
        <ScrollViewer
            x:Name="LetterScroller"
            Grid.RowSpan="2"
            HorizontalScrollMode="Disabled">
            <StackPanel
                x:Name="LetterStack"
                Padding="16"
                Spacing="12">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{markup:Localize Key=WishesTitle}" />

                <controls:KidPicker Picker="{x:Bind ViewModel.KidPicker}" Visibility="{x:Bind ViewModel.KidPicker.HasSeveralKids, Mode=OneWay}" />

                <Border
                    x:Name="Letter"
                    MinHeight="360"
                    Padding="24"
                    VerticalAlignment="Top"
                    Background="{ThemeResource LetterPaperBrush}"
                    BorderBrush="{ThemeResource LetterLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RenderTransformOrigin="0.5,0.5"
                    RequestedTheme="Light">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="LetterTransform" />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.AutomationId="LetterSalutation"
                            FontSize="32"
                            Style="{StaticResource LetterTextStyle}"
                            Text="{x:Bind ViewModel.Salutation, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource LetterTextStyle}" Text="{markup:Localize Key=LetterIntro}" />

                        <!--  An empty letter asks for the first wish, and the slot opens the pictures.  -->
                        <Button
                            MinHeight="96"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="EmptyLetterInvite"
                            AutomationProperties.Name="{markup:Localize Key=EmptyLetterInvite}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="EmptyLetterInvite_Click"
                            CornerRadius="16"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                            <Grid>
                                <Rectangle
                                    RadiusX="16"
                                    RadiusY="16"
                                    Stroke="{ThemeResource LetterLineBrush}"
                                    StrokeDashArray="3,2"
                                    StrokeThickness="3" />
                                <StackPanel
                                    Padding="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <FontIcon
                                        FontSize="28"
                                        Foreground="{ThemeResource BrandBrush}"
                                        Glyph="&#xE710;" />
                                    <TextBlock
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource LetterTextStyle}"
                                        Text="{markup:Localize Key=EmptyLetterInvite}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <ItemsRepeater x:Name="WishesRepeater" ItemsSource="{x:Bind ViewModel.Wishes}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WishItemViewModel">
                                    <Grid
                                        Padding="4"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource LetterLineBrush}"
                                        BorderThickness="0,0,0,1"
                                        ColumnSpacing="12"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <CompositeTransform />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Width="40"
                                            Height="40"
                                            Source="{x:Bind controls:Stickers.Image(Sticker)}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LetterTextStyle}"
                                            Text="{x:Bind Label}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="48"
                                            Height="48"
                                            Padding="0"
                                            AutomationProperties.Name="{markup:Localize Key=RemoveWish}"
                                            Background="{ThemeResource LetterLineBrush}"
                                            BorderThickness="0"
                                            Click="RemoveWish_Click"
                                            CornerRadius="24"
                                            Foreground="{ThemeResource LetterInkBrush}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{markup:Localize Key=RemoveWish}">
                                            <FontIcon FontSize="18" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel Margin="0,12,0,0" Spacing="4">
                            <TextBlock Style="{StaticResource LetterTextStyle}" Text="{markup:Localize Key=LetterSignOff}" />
                            <TextBox
                                AutomationProperties.AutomationId="LetterKidName"
                                AutomationProperties.Name="{markup:Localize Key=YourName}"
                                FontFamily="{StaticResource HandwritingFontFamily}"
                                FontSize="24"
                                MaxLength="24"
                                PlaceholderText="{markup:Localize Key=YourName}"
                                Text="{x:Bind ViewModel.KidName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Building the letter. Pinned above the tabs on a phone, a column of its own when wide.  -->
        <StackPanel
            x:Name="Tools"
            Grid.Column="1"
            Margin="8,16,16,16"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsWriting, Mode=OneWay}">
            <TextBlock
                x:Name="ToolsHeading"
                Foreground="{ThemeResource PageTextBrush}"
                Style="{StaticResource FriendlyStrongTextStyle}"
                Text="{markup:Localize Key=WishPrompt}" />

            <Border
                Padding="12,4,4,4"
                Background="{ThemeResource LetterPaperBrush}"
                CornerRadius="12"
                RequestedTheme="Light"
                Visibility="{x:Bind ViewModel.CanUndoRemove, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource LetterInkBrush}"
                        Text="{x:Bind ViewModel.RemovedMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        MinHeight="44"
                        Padding="16,4"
                        AutomationProperties.AutomationId="UndoRemoveButton"
                        Command="{x:Bind ViewModel.UndoRemoveCommand}"
                        Content="{markup:Localize Key=UndoRemoveWish}"
                        CornerRadius="22"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!--  Pictures first: the chosen one waits here until ＋ puts it on the letter.  -->
            <controls:StickerPicker
                x:Name="PicturePicker"
                ChooseCommand="{x:Bind ViewModel.ChoosePictureCommand}"
                Groups="{x:Bind ViewModel.StickerGroups}"
                SelectedSticker="{x:Bind ViewModel.SelectedSticker, Mode=OneWay}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NewWishBox"
                    MinHeight="48"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="NewWishBox"
                    AutomationProperties.Name="{markup:Localize Key=WishPrompt}"
                    FontSize="20"
                    KeyDown="NewWish_KeyDown"
                    MaxLength="{x:Bind ViewModel.WishMaxLength}"
                    PlaceholderText="{x:Bind ViewModel.WishPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.NewWishText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Width="48"
                    Height="48"
                    Padding="0"
                    AutomationProperties.AutomationId="AddWishButton"
                    AutomationProperties.Name="{markup:Localize Key=AddWish}"
                    Command="{x:Bind ViewModel.AddWishCommand}"
                    CornerRadius="24"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{markup:Localize Key=AddWish}">
                    <FontIcon FontSize="20" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <!--  Sending is the second stage. On a phone this moves to the end of the letter.  -->
            <StackPanel
                x:Name="FinishPanel"
                Margin="0,16,0,0"
                Padding="0,16,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsWriting, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.AutomationId="SendHint"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource PageTextBrush}"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource FriendlyStrongTextStyle}"
                    Text="{x:Bind ViewModel.SendHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SendLetterButton"
                    Command="{x:Bind ViewModel.SendLetterCommand}"
                    Content="{markup:Localize Key=SendLetter}"
                    Style="{StaticResource BigActionButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!--  Sent!  -->
        <StackPanel
            x:Name="SentPanel"
            Grid.Column="1"
            Margin="8,16,16,16"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsSent, Mode=OneWay}">
            <Image
                x:Name="SentImage"
                Width="112"
                Height="112"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/Stickers/letter.png" />
            <TextBlock
                x:Name="SentMessage"
                AutomationProperties.AutomationId="LetterSentMessage"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource PageTextBrush}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource PageTitleTextStyle}"
                Text="{x:Bind ViewModel.SentMessage, Mode=OneWay}" />
            <Button
                MinHeight="48"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="WriteMoreButton"
                Command="{x:Bind ViewModel.WriteMoreCommand}"
                Content="{markup:Localize Key=WriteMore}"
                CornerRadius="24" />
            <Button
                MinHeight="48"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="ShareWishesButton"
                Command="{x:Bind ViewModel.ShareWithGrownUpsCommand}"
                Content="{markup:Localize Key=ShareWishes}"
                CornerRadius="24" />
        </StackPanel>

        <!--  On the page's root, or the triggers never fire and a narrow window keeps both columns.  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates" CurrentStateChanged="LayoutStates_CurrentStateChanged">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToolsColumn.Width" Value="0" />
                        <Setter Target="LetterScroller.(Grid.RowSpan)" Value="1" />
                        <Setter Target="Tools.(Grid.Column)" Value="0" />
                        <Setter Target="Tools.(Grid.Row)" Value="1" />
                        <Setter Target="Tools.Margin" Value="0" />
                        <Setter Target="Tools.Padding" Value="12" />
                        <Setter Target="Tools.Background" Value="{ThemeResource AppBarBackgroundBrush}" />
                        <Setter Target="Tools.BorderThickness" Value="0,1,0,0" />
                        <Setter Target="ToolsHeading.Visibility" Value="Collapsed" />
                        <Setter Target="FinishPanel.Margin" Value="0,8,0,8" />
                        <Setter Target="FinishPanel.BorderThickness" Value="0" />
                        <Setter Target="SentPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SentPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SentPanel.Margin" Value="0" />
                        <Setter Target="SentPanel.Padding" Value="12" />
                        <Setter Target="SentPanel.Background" Value="{ThemeResource AppBarBackgroundBrush}" />
                        <Setter Target="SentPanel.BorderThickness" Value="0,1,0,0" />
                        <Setter Target="SentImage.Width" Value="64" />
                        <Setter Target="SentImage.Height" Value="64" />
                        <Setter Target="SentMessage.FontSize" Value="24" />
                        <Setter Target="Letter.MinHeight" Value="0" />
                        <Setter Target="Letter.Padding" Value="16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="840" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:WishListViewBase>
