<UserControl
    x:Class="MerryCountdown.Views.DisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MerryCountdown.Controls"
    xmlns:markup="using:MerryCountdown.Markup"
    xmlns:vm="using:MerryCountdown.Core.ViewModels"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    PointerMoved="OnPointerMoved">

    <Grid Background="{StaticResource SceneGlassStrongBrush}">
        <controls:SceneCanvas
            AutomationProperties.AutomationId="DisplayScene"
            AutomationProperties.Name="{markup:Localize Key=SceneAccessibleName}"
            CalmMotion="{x:Bind ViewModel.CalmMotion, Mode=OneWay}"
            SceneId="{x:Bind ViewModel.SceneId, Mode=OneWay}"
            Snow="{x:Bind ViewModel.Snow, Mode=OneWay}" />

        <!--  Designed once at 1920x1080 for reading from the sofa, then scaled to whatever screen this is.  -->
        <Viewbox
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Stretch="Uniform">
            <Grid
                Width="1920"
                Height="1080"
                Padding="72,48">
                <Grid.RenderTransform>
                    <TranslateTransform X="{x:Bind ViewModel.DriftX, Mode=OneWay}" Y="{x:Bind ViewModel.DriftY, Mode=OneWay}" />
                </Grid.RenderTransform>

                <!--  Time and date, top corners  -->
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="DisplayDate"
                    FontSize="40"
                    Style="{StaticResource SceneCaptionTextStyle}"
                    Text="{x:Bind ViewModel.Today, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="DisplayClock"
                    FontSize="64"
                    Style="{StaticResource SceneTitleTextStyle}"
                    Text="{x:Bind ViewModel.Clock, Mode=OneWay}" />

                <!--  The big number  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsCounting, Mode=OneWay}">
                    <Grid Height="330">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DisplaySleeps"
                            FontSize="320"
                            Style="{StaticResource HeroNumberTextStyle}"
                            Text="{x:Bind ViewModel.SleepsNumber, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        FontSize="72"
                        Style="{StaticResource SceneTitleTextStyle}"
                        Text="{x:Bind ViewModel.SleepsCaption, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="44"
                        Style="{StaticResource SceneCaptionTextStyle}"
                        Text="{x:Bind ViewModel.Countdown, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Margin="0,160,0,0"
                    VerticalAlignment="Top"
                    FontSize="160"
                    Style="{StaticResource SceneTitleTextStyle}"
                    Text="{markup:Localize Key=HeadlineCelebrating}"
                    Visibility="{x:Bind ViewModel.IsCelebrating, Mode=OneWay}" />

                <!--  Everyone's day, bottom  -->
                <StackPanel VerticalAlignment="Bottom" Spacing="16">
                    <ItemsRepeater HorizontalAlignment="Center" ItemsSource="{x:Bind ViewModel.Kids}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="24" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DisplayKidViewModel">
                                <Border
                                    Padding="24,12"
                                    Background="{StaticResource SceneGlassStrongBrush}"
                                    BorderBrush="{StaticResource SceneGlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Image
                                            Width="72"
                                            Height="72"
                                            Source="{x:Bind controls:Stickers.Image(Sticker)}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                FontSize="40"
                                                Style="{StaticResource SceneTitleTextStyle}"
                                                Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                FontSize="28"
                                                Style="{StaticResource SceneCaptionTextStyle}"
                                                Text="{x:Bind Status, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Border
                        Padding="24,8"
                        HorizontalAlignment="Center"
                        Background="{StaticResource SceneGlassStrongBrush}"
                        CornerRadius="24">
                        <TextBlock
                            AutomationProperties.AutomationId="DisplayFact"
                            FontSize="36"
                            Style="{StaticResource SceneCaptionTextStyle}"
                            Text="{x:Bind ViewModel.DailyFact, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Viewbox>

        <!--  Appears on any touch, wiggle or key press, then gets out of the way.  -->
        <StackPanel
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsHintVisible, Mode=OneWay}">
            <Border
                Padding="16,8"
                Background="{StaticResource SceneGlassStrongBrush}"
                CornerRadius="24">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SceneTextBrush}"
                    Text="{markup:Localize Key=DisplayHint}"
                    TextWrapping="Wrap" />
            </Border>
            <Button
                AutomationProperties.AutomationId="NextSceneButton"
                AutomationProperties.Name="{markup:Localize Key=ChooseScene}"
                Command="{x:Bind ViewModel.NextSceneCommand}"
                Style="{StaticResource SceneRoundButtonStyle}">
                <FontIcon FontSize="24" Glyph="&#xE790;" />
            </Button>
            <Button
                AutomationProperties.AutomationId="ExitDisplayButton"
                AutomationProperties.Name="{markup:Localize Key=DisplayExit}"
                Command="{x:Bind ViewModel.ExitCommand}"
                Style="{StaticResource SceneRoundButtonStyle}">
                <FontIcon FontSize="24" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
