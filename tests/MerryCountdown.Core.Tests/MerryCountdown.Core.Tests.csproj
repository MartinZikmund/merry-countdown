<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <UnoDisableUNOB0029Validation>true</UnoDisableUNOB0029Validation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MerryCountdown.Core\MerryCountdown.Core.csproj" />
  </ItemGroup>

  <!-- Assertion + mocking stack prescribed by .claude/rules/testing.md.
       Versions match src/Directory.Packages.props (tests live outside the CPM scope). -->
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.7.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.2.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.157.0" />
  </ItemGroup>

</Project>
